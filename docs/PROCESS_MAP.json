{
  "schema": "pete.sudoku-discovery.process-map.v1",
  "processes": [
    {"id":"substrate.generate","I":["size","difficulty","seed"],"P":"execute hidden world construction","O":["public initial state"],"D":["private authority state"]},
    {"id":"body.sense","I":["external state"],"P":"encode through finite sensor port","O":["vision packet","interoception"],"D":[]},
    {"id":"cognition.select_experiment","I":["goal","current uncertainty"],"P":"choose two-binding controlled intervention","O":["motor intention"],"D":["experiment progress"]},
    {"id":"body.act","I":["motor intention"],"P":"transduce and commit","O":["binary consequence","new observation"],"D":["hash-chained episode"]},
    {"id":"fieldmap.observe_gap","I":["binding pair","binary consequence"],"P":"update explicit evidence","O":["weighted relation evidence"],"D":["dynamic samples"]},
    {"id":"fieldmap.collapse","I":["weighted relation evidence"],"P":"select compact zero-counterexample cover","O":["predictive clauses"],"D":["Fieldmap version"]},
    {"id":"sandbox.search","I":["public puzzle","predictive clauses"],"P":"generic finite-domain counterfactual search","O":["intended complete state"],"D":["attempt count"]},
    {"id":"body.commit","I":["intended state"],"P":"commit each difference through actuator","O":["physical receipts"],"D":["hash-chained episodes"]},
    {"id":"substrate.grade","I":["committed external state"],"P":"apply hidden authority","O":["complete or counterexample"],"D":["world progression"]}
  ]
}
